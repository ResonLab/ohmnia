{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Nexika designe ses modules internes avec leur extension .ts, pour que
    // Node 24 puisse le charger seul, sans empaqueteur. C'est ce qui lui
    // permet de s'eprouver lui-meme et d'etre lance sans installation.
    "allowImportingTsExtensions": true,
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/serveur/**/*",
    "electron.vite.config.ts"
  ]
}
