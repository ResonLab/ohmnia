{
  "name": "ohmnia",
  "version": "0.2.1",
  "description": "Ohmnia - gestion locale pour technicien electronicien independant",
  "main": "./out/main/index.js",
  "author": "Colin Meng",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "publish:win": "electron-vite build && electron-builder --win --publish always",
    "package:linux": "electron-vite build && electron-builder --linux --publish never",
    "publish:linux": "electron-vite build && electron-builder --linux --publish always",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node tests/lancer-tout.mjs",
    "verifier": "npm run typecheck && npm test",
    "serveur:build": "node scripts/construire-serveur.mjs",
    "serveur": "node scripts/construire-serveur.mjs && node out/serveur/ohmnia-serveur.mjs",
    "guide:publier": "node scripts/publier-guide.mjs",
    "guide:pdf": "electron scripts/guide-pdf.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "nexika": "github:ResonLab/nexika",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "allowScripts": {
    "better-sqlite3@13.0.2": true
  }
}
