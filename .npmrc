# npm 12 refuse par defaut toute dependance installee depuis un depot git
# (`allow-git = none`) : c'est une protection contre les chaines
# d'approvisionnement, et elle est bienvenue.
#
# Ohmnia en a besoin d'exactement une : `nexika`, le serveur commun de la
# maison, qui n'est pas publie sur le registre npm.
#
# `root` autorise les dependances git **declarees par ce projet**, et refuse
# celles qu'une dependance amenerait dans son dos. `all` ouvrirait les deux.
allow-git=root
